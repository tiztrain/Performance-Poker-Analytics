# Copy to .env.local (gitignored) to turn on login in `npm run dev`.
# Values come from `terraform output` in infra/. Neither is a secret: both end up in
# the built JavaScript that every visitor downloads.
# Leave them unset and the app runs without the sign-in buttons.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Optional AI chat: `terraform output -raw chat_api_url` once enable_chat is on. Needs login too.
VITE_CHAT_API_URL=
